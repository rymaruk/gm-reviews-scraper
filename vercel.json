{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/store.ts": {
      "includeFiles": "{server,src/lib}/**",
      "maxDuration": 30
    },
    "api/reviews.ts": {
      "includeFiles": "{server,src/lib}/**",
      "maxDuration": 60
    },
    "api/places/resolve.ts": {
      "includeFiles": "{server,src/lib}/**",
      "maxDuration": 60
    },
    "api/campaigns/[id].ts": {
      "includeFiles": "{server,src/lib}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
